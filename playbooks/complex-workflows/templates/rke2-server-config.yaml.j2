# RKE2 Server Configuration
# Generated by Ansible

# Cluster settings
cluster-name: {{ k8s_cluster_name }}
server: https://{{ hostvars[groups['k8s_masters'][0]]['ansible_default_ipv4']['address'] }}:9345

# Network configuration
cluster-cidr: {{ k8s_cluster_cidr }}
service-cidr: {{ k8s_service_cidr }}
cluster-dns: {{ k8s_cluster_dns }}
cluster-domain: {{ k8s_cluster_domain }}

# Security settings
{% if k8s_audit_enabled | default(true) %}
audit-policy-file: /etc/rancher/rke2/audit-policy.yaml
audit-log-path: /var/lib/rancher/rke2/server/logs/audit.log
audit-log-maxage: 30
audit-log-maxbackup: 10
audit-log-maxsize: 100
{% endif %}

# CNI configuration
cni: canal

# Disable components
disable:
  - rke2-ingress-nginx
{% if not k8s_metrics_server_enabled | default(true) %}
  - rke2-metrics-server
{% endif %}

# Node configuration
{% if k8s_node_labels is defined and k8s_node_labels | length > 0 %}
node-label:
{% for label_key, label_value in k8s_node_labels.items() %}
  - "{{ label_key }}={{ label_value }}"
{% endfor %}
{% endif %}

{% if k8s_node_taints is defined and k8s_node_taints | length > 0 %}
node-taint:
{% for taint in k8s_node_taints %}
  - "{{ taint }}"
{% endfor %}
{% endif %}

# TLS settings
tls-san:
  - {{ ansible_default_ipv4.address }}
  - {{ ansible_fqdn | default(ansible_hostname) }}
{% for master in groups['k8s_masters'] | default([]) %}
{% if master != inventory_hostname %}
  - {{ hostvars[master]['ansible_default_ipv4']['address'] }}
  - {{ hostvars[master]['ansible_fqdn'] | default(hostvars[master]['ansible_hostname']) }}
{% endif %}
{% endfor %}

# Backup configuration
{% if k8s_etcd_backup_enabled | default(true) %}
etcd-snapshot-schedule-cron: "{{ k8s_etcd_backup_schedule | default('0 */12 * * *') }}"
etcd-snapshot-retention: {{ k8s_etcd_backup_retention | default('5') }}
etcd-snapshot-dir: /var/lib/rancher/rke2/server/db/snapshots
{% endif %}