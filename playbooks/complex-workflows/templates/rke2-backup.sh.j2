#!/bin/bash
# RKE2 Backup Script
# Generated by Ansible

set -euo pipefail

# Configuration
BACKUP_DIR="/var/lib/rancher/rke2/server/backup"
SNAPSHOT_DIR="/var/lib/rancher/rke2/server/db/snapshots"
RETENTION_DAYS={{ k8s_etcd_backup_retention | default('7') }}
LOG_FILE="/var/log/rke2-backup.log"

# Create backup directory
mkdir -p "$BACKUP_DIR"

# Function to log messages
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$LOG_FILE"
}

log "Starting RKE2 backup process"

# Check if RKE2 server is running
if ! systemctl is-active --quiet rke2-server; then
    log "ERROR: RKE2 server is not running"
    exit 1
fi

# Create etcd snapshot
log "Creating etcd snapshot"
if /var/lib/rancher/rke2/bin/rke2 etcd-snapshot save --name "backup-$(date +%Y%m%d-%H%M%S)"; then
    log "Etcd snapshot created successfully"
else
    log "ERROR: Failed to create etcd snapshot"
    exit 1
fi

# Backup certificates and configuration
log "Backing up certificates and configuration"
BACKUP_NAME="rke2-backup-$(date +%Y%m%d-%H%M%S)"
BACKUP_PATH="$BACKUP_DIR/$BACKUP_NAME.tar.gz"

tar -czf "$BACKUP_PATH" \
    -C /var/lib/rancher/rke2/server \
    cred \
    tls \
    token \
    node-token \
    --exclude='*.log' || {
    log "ERROR: Failed to backup certificates and configuration"
    exit 1
}

log "Configuration backup created: $BACKUP_PATH"

# Backup kubectl config
if [ -f "/etc/rancher/rke2/rke2.yaml" ]; then
    cp "/etc/rancher/rke2/rke2.yaml" "$BACKUP_DIR/kubeconfig-$(date +%Y%m%d-%H%M%S).yaml"
    log "Kubeconfig backed up"
fi

# Clean up old backups
log "Cleaning up old backups (retention: $RETENTION_DAYS days)"

# Clean up old snapshots
find "$SNAPSHOT_DIR" -name "backup-*.db" -mtime +$RETENTION_DAYS -delete 2>/dev/null || true

# Clean up old backup files
find "$BACKUP_DIR" -name "rke2-backup-*.tar.gz" -mtime +$RETENTION_DAYS -delete 2>/dev/null || true
find "$BACKUP_DIR" -name "kubeconfig-*.yaml" -mtime +$RETENTION_DAYS -delete 2>/dev/null || true

# Display backup summary
SNAPSHOT_COUNT=$(ls -1 "$SNAPSHOT_DIR"/backup-*.db 2>/dev/null | wc -l)
BACKUP_COUNT=$(ls -1 "$BACKUP_DIR"/rke2-backup-*.tar.gz 2>/dev/null | wc -l)

log "Backup completed successfully"
log "Current snapshots: $SNAPSHOT_COUNT"
log "Current backups: $BACKUP_COUNT"

# Optional: Upload to remote storage
{% if k8s_backup_remote_enabled | default(false) %}
log "Uploading backup to remote storage"
# Add your remote backup logic here (S3, rsync, etc.)
{% endif %}

log "RKE2 backup process completed"