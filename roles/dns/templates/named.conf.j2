//
// named.conf - BIND Configuration File
// Generated by Ansible
//

options {
	listen-on port 53 { 
{% for addr in dns_listen_on %}
		{{ addr }};
{% endfor %}
	};
	
{% if dns_listen_on_v6 is defined %}
	listen-on-v6 port 53 { 
{% for addr in dns_listen_on_v6 %}
		{{ addr }};
{% endfor %}
	};
{% endif %}

	directory 	"{{ dns_zone_dir if not dns_chroot_enabled else '/var/named' }}";
	dump-file 	"{{ dns_data_dir if not dns_chroot_enabled else '/var/named/data' }}/cache_dump.db";
	statistics-file "{{ dns_data_dir if not dns_chroot_enabled else '/var/named/data' }}/named_stats.txt";
	memstatistics-file "{{ dns_data_dir if not dns_chroot_enabled else '/var/named/data' }}/named_mem_stats.txt";
	
	allow-query { 
{% for acl in dns_allow_query %}
		{{ acl }};
{% endfor %}
	};

{% if dns_allow_recursion is defined %}
	allow-recursion {
{% for acl in dns_allow_recursion %}
		{{ acl }};
{% endfor %}
	};
{% endif %}

	recursion {{ dns_recursion | lower }};

{% if dns_forwarders is defined and dns_forwarders | length > 0 %}
	forwarders {
{% for forwarder in dns_forwarders %}
		{{ forwarder }};
{% endfor %}
	};
{% endif %}

	dnssec-enable {{ dns_dnssec_enable | lower }};
	dnssec-validation {{ dns_dnssec_validation | lower }};

	/* Path to ISC DLV key */
	bindkeys-file "/etc/named.iscdlv.key";

	managed-keys-directory "{{ dns_data_dir if not dns_chroot_enabled else '/var/named/dynamic' }}";

	pid-file "/run/named/named.pid";
	session-keyfile "/run/named/session.key";

	/* Performance tuning */
	cleaning-interval {{ dns_cleaning_interval }};
	interface-interval {{ dns_interface_interval }};
	max-cache-size {{ dns_max_cache_size }};
	max-cache-ttl {{ dns_max_cache_ttl }};
	max-ncache-ttl {{ dns_max_ncache_ttl }};
};

{% if dns_log_level is defined %}
logging {
        channel default_debug {
                file "{{ dns_log_dir if not dns_chroot_enabled else '/var/log' }}/named.run";
                severity {{ dns_log_level }};
                print-category yes;
                print-severity yes;
                print-time yes;
        };
        
{% if dns_log_queries | default(false) %}
        channel query_log {
                file "{{ dns_log_dir if not dns_chroot_enabled else '/var/log' }}/query.log" versions 3 size 10m;
                severity info;
                print-category yes;
                print-severity yes;
                print-time yes;
        };
        category queries { query_log; };
{% endif %}

{% if dns_log_transfers | default(false) %}
        channel transfer_log {
                file "{{ dns_log_dir if not dns_chroot_enabled else '/var/log' }}/transfer.log" versions 3 size 10m;
                severity info;
                print-category yes;
                print-severity yes;
                print-time yes;
        };
        category xfer-in { transfer_log; };
        category xfer-out { transfer_log; };
{% endif %}
};
{% endif %}

zone "." IN {
	type hint;
	file "named.ca";
};

include "/etc/named.rfc1912.zones";
include "/etc/named.root.key";

{% if dns_zones is defined %}
// Custom zones
{% for zone in dns_zones %}
zone "{{ zone.name }}" IN {
	type {{ zone.type | default('master') }};
	file "{{ zone.filename }}";
{% if zone.allow_update is defined %}
	allow-update { {{ zone.allow_update | join('; ') }}; };
{% endif %}
{% if zone.also_notify is defined %}
	also-notify { {{ zone.also_notify | join('; ') }}; };
{% endif %}
};

{% endfor %}
{% endif %}

{% if dns_reverse_zones is defined %}
// Reverse zones
{% for zone in dns_reverse_zones %}
zone "{{ zone.network }}.in-addr.arpa" IN {
	type {{ zone.type | default('master') }};
	file "{{ zone.filename }}";
{% if zone.allow_update is defined %}
	allow-update { {{ zone.allow_update | join('; ') }}; };
{% endif %}
};

{% endfor %}
{% endif %}