$TTL {{ zone.ttl | default(86400) }}
@	IN	SOA	{{ zone.primary_ns | default(ansible_fqdn + '.') }}	{{ zone.admin_email | default(dns_default_soa.admin_email) }}. (
			{{ zone.serial | default(dns_default_soa.serial) }}	; Serial
			{{ zone.refresh | default(dns_default_soa.refresh) }}		; Refresh
			{{ zone.retry | default(dns_default_soa.retry) }}		; Retry
			{{ zone.expire | default(dns_default_soa.expire) }}		; Expire
			{{ zone.minimum | default(dns_default_soa.minimum) }} )	; Negative Cache TTL

; Name servers
@	IN	NS	{{ zone.primary_ns | default(ansible_fqdn + '.') }}
{% if zone.secondary_ns is defined %}
{% for ns in zone.secondary_ns %}
@	IN	NS	{{ ns }}
{% endfor %}
{% endif %}

; A Records
{% if zone.records is defined %}
{% for record in zone.records %}
{% if record.type == 'A' %}
{{ record.name }}	IN	A	{{ record.value }}
{% elif record.type == 'AAAA' %}
{{ record.name }}	IN	AAAA	{{ record.value }}
{% elif record.type == 'CNAME' %}
{{ record.name }}	IN	CNAME	{{ record.value }}
{% elif record.type == 'MX' %}
{{ record.name }}	IN	MX	{{ record.priority | default(10) }}	{{ record.value }}
{% elif record.type == 'TXT' %}
{{ record.name }}	IN	TXT	"{{ record.value }}"
{% elif record.type == 'SRV' %}
{{ record.name }}	IN	SRV	{{ record.priority | default(10) }}	{{ record.weight | default(60) }}	{{ record.port }}	{{ record.target }}
{% elif record.type == 'PTR' %}
{{ record.name }}	IN	PTR	{{ record.value }}
{% endif %}
{% endfor %}
{% endif %}

; Default records if none specified
{% if zone.records is not defined %}
@	IN	A	{{ ansible_default_ipv4.address }}
www	IN	A	{{ ansible_default_ipv4.address }}
{% endif %}