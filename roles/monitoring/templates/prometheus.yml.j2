# Prometheus Configuration
# Generated by Ansible

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    monitor: 'ansible-lab-monitor'
    environment: '{{ prometheus_environment | default("lab") }}'

# Rules and alerts
rule_files:
  - "rules.yml"

# Alerting configuration
{% if alertmanager_enabled | default(false) %}
alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - localhost:{{ alertmanager_port | default(9093) }}
{% endif %}

# Scrape configurations
scrape_configs:
  # Prometheus itself
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:{{ prometheus_port }}']

  # Node Exporter instances
  - job_name: 'node_exporter'
    static_configs:
{% for host_group in groups.keys() %}
{% if host_group != 'all' and host_group != 'ungrouped' %}
      # {{ host_group | title }} Group
{% for host in groups[host_group] %}
{% set host_vars = hostvars[host] %}
{% if host_vars.ansible_default_ipv4 is defined %}
      - targets: ['{{ host_vars.ansible_default_ipv4.address }}:{{ node_exporter_port }}']
        labels:
          instance: '{{ host_vars.ansible_fqdn | default(host) }}'
          group: '{{ host_group }}'
          os_family: '{{ host_vars.ansible_os_family | default("Unknown") }}'
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}

{% if prometheus_custom_jobs is defined %}
  # Custom job configurations
{% for job in prometheus_custom_jobs %}
  - job_name: '{{ job.name }}'
    {% if job.scrape_interval is defined %}
    scrape_interval: {{ job.scrape_interval }}
    {% endif %}
    {% if job.metrics_path is defined %}
    metrics_path: {{ job.metrics_path }}
    {% endif %}
    static_configs:
{% for target in job.targets %}
      - targets: {{ target.endpoints | to_json }}
        {% if target.labels is defined %}
        labels:
{% for label_key, label_value in target.labels.items() %}
          {{ label_key }}: '{{ label_value }}'
{% endfor %}
        {% endif %}
{% endfor %}
{% endfor %}
{% endif %}

# Remote write configuration (if enabled)
{% if prometheus_enable_remote_write | default(false) %}
remote_write:
  - url: "{{ prometheus_remote_write_url }}"
    {% if prometheus_remote_write_basic_auth is defined %}
    basic_auth:
      username: "{{ prometheus_remote_write_basic_auth.username }}"
      password: "{{ prometheus_remote_write_basic_auth.password }}"
    {% endif %}
{% endif %}

# Storage configuration
storage:
  tsdb:
    retention.time: {{ prometheus_retention_time }}
    retention.size: {{ prometheus_storage_retention_size }}