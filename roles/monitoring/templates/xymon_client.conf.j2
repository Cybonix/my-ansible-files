# Xymon Client Configuration
# Generated by Ansible

# Xymon server details
XYMONSERVERS="{{ xymon_server_address }}"
XYMONDPORT="{{ xymon_server_port }}"

# Client settings
CLIENTHOSTNAME="{{ ansible_fqdn | default(ansible_hostname) }}"
CLIENTOS="{{ ansible_distribution }}"
CLIENTOSTYPE="linux"

# Logging
LOGFILE="{{ xymon_client_log_dir }}/xymonclient.log"
LOGLEVEL="info"

# Intervals (in seconds)
SLEEPBETWEENMSGS=5
CLIENTUPDATEINTERVAL=300

# Network settings
TIMEOUT=30

# Custom scripts directory
SCRIPTDIR="{{ xymon_client_scripts_dir }}"

# Include custom client configuration
{% for config_item in xymon_client_custom_config | default([]) %}
{{ config_item.key }}="{{ config_item.value }}"
{% endfor %}

# Host-specific monitoring configuration
{% if xymon_client_tests is defined %}
# Custom tests for this host
{% for test in xymon_client_tests %}
{{ test }}
{% endfor %}
{% endif %}